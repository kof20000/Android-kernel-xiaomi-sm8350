# DTS
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=m

# Haptics
CONFIG_INPUT_QCOM_HV_HAPTICS=m
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# KernelSU
CONFIG_KSU=y

# MM
CONFIG_MEMORY_HOTPLUG=n

# Net
CONFIG_IP_NF_TARGET_TTL=y

# Power Supply
CONFIG_BQ2597X=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# VM
CONFIG_HVC_HAVEN=n

# WiFi
CONFIG_CNSS_QCA6490=y
CONFIG_QCA_CLD_WLAN=y
