# DTS
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y

# Haptics
CONFIG_INPUT_QCOM_HV_HAPTICS=y
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# KernelSU
CONFIG_KSU=y

# MM
CONFIG_MEMORY_HOTPLUG=n

# Net
CONFIG_IP_NF_TARGET_TTL=y

# Pinctrl
CONFIG_PINCTRL_SM8350=y
CONFIG_PINCTRL_HAYDN=y

# Power Supply
CONFIG_AI_RSOC_M20=y
CONFIG_BQ2597X=y
CONFIG_BQ_CLOUD_AUTHENTICATION=y
CONFIG_BQ_FG_1S=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_HAYDN_FOR_BUILD=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# VM
CONFIG_HVC_HAVEN=n

# WiFi
CONFIG_CNSS_QCA6490=y
CONFIG_QCA_CLD_WLAN=y

#Toolchain
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
